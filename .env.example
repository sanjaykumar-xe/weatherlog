# One file for both apps. Copy to .env in the repository root.

# --- Backend (loaded with `uvicorn --env-file ../.env`) ---
# SQLite file, relative to the directory uvicorn is started from (backend/)
DATABASE_URL=sqlite:///./weatherlog.db
# Comma-separated browser origins allowed to call the API (add the deployed frontend URL here)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Timeout for each Open-Meteo request, in seconds
PROVIDER_TIMEOUT_SECONDS=10

# --- Frontend (read by Vite; only VITE_ variables reach the browser) ---
VITE_API_BASE_URL=http://localhost:8000/api
# Shown in the page footer when set
VITE_APPLICANT_NAME=
